#!/usr/bin/env bash
# Helper Claude runs to record the task ID or topic for a session.
# Usage:
#   tempo-task <session_id> task <TASK_ID>
#   tempo-task <session_id> topic <text...>
set -euo pipefail

STATE_DIR="${TEMPO_STATE_DIR:-$HOME/.claude/tempo-sessions}"

if [ $# -lt 3 ]; then
  echo "Usage: tempo-task <session_id> task|topic <value...>" >&2
  exit 1
fi

session_id="$1"
field="$2"
shift 2
value="$*"

case "$field" in
  task)  key="task_id" ;;
  topic) key="topic" ;;
  *) echo "Unknown field '$field' (expected: task or topic)" >&2; exit 1 ;;
esac

mkdir -p "$STATE_DIR"
state="$STATE_DIR/$session_id.json"
[ -f "$state" ] || echo '{}' > "$state"

tmp="$(mktemp "$STATE_DIR/.tmp.XXXXXX")"
jq --arg v "$value" ".$key = \$v" "$state" > "$tmp"
mv "$tmp" "$state"

echo "[claude-tempo-log] $key recorded: $value"
