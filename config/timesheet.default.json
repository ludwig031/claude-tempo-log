      "*preprod*",
      "*staging*",
      "*stage.*",
      "*.netgen.host"
    ],
    "tool_hosts": [
      "atlassian.net",
      "bitbucket.org",
      "github.com",
      "gitlab.com",
      "sentry.io",
      "console.cloud.google.com",
      "aistudio.google.com",
